# ISO volume label, at most 32 characters. The boot menu finds the disc by it
# (root=live:CDLABEL=...), so grub.cfg and livecd/volid are rendered from this one value.
ISO_VOLID=GENTOO_INSTALLER_AMD64
# Kernel arguments of every boot-menu entry (see iso/specs/livecd-stage2.spec for why
# secureconsole stays and dokeymap is absent).
ISO_BOOTARGS="nodhcp secureconsole"
