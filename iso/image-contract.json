{
  "schema_version": 1,
  "description": "What scripts/verify-iso.py requires of every finished ISO. Keep it in step with iso/specs, iso/root_overlay and iso/fsscript-stage2.sh; tests/iso checks the obvious drift. An item with \"when_source\" only applies while that file exists in the source tree (or, as {path, contains}, while it contains that text).",
  "iso": {
    "required_files": [
      "boot/gentoo",
      "boot/gentoo.igz",
      "boot/grub/grub.cfg",
      "image.squashfs",
      "livecd",
      "README.txt",
      "SECURE-BOOT-OFF.txt",
      "efi.img",
      "efi/boot/bootx64.efi",
      "efi/boot/bootia32.efi",
      "boot/grub/i386-pc/eltorito.img",
      "memtest64.bios",
      "memtest.efi64",
      "boot/gentoo-config"
    ],
    "required_dirs": [
      "boot/grub/i386-pc",
      "boot/grub/x86_64-efi",
      "boot/grub/i386-efi",
      "boot/grub/themes/gentoo_frosted"
    ],
    "forbidden_files": []
  },
  "grub": {
    "kernel": "/boot/gentoo",
    "initrd": "/boot/gentoo.igz",
    "min_entries": 13,
    "required_arguments": ["nox", "dokeymap", "nomodeset", "rd.live.ram=1", "console=ttyS0,115200n8", "acpi=off", "rd.debug", "gentoo.autostart=rescue", "gentoo.autostart=ai-rescue", "gentoo.autostart=installer-text"],
    "required_argument_groups": [
      "nox dokeymap",
      "nox dokeymap gentoo.autostart=rescue",
      "nox dokeymap gentoo.autostart=ai-rescue",
      "nox dokeymap gentoo.autostart=installer-text",
      "nomodeset pcie_aspm=off nvme_core.default_ps_max_latency_us=0 usbcore.autosuspend=-1"
    ],
    "autostart_values": ["rescue", "ai-rescue", "installer-text"],
    "required_titles": ["Safe graphics (for a black screen or no picture)", "Repair a system (text console)", "AI rescue (text console)", "Install in text mode"],
    "safe_graphics": {"title_prefix": "safe graphics", "required_arguments": ["nomodeset"], "forbidden_arguments": ["nox", "dokeymap"]},
    "forbidden_titles": []
  },
  "kernel_config": {
    "file": "boot/gentoo-config",
    "why": "H1: without a generic framebuffer DRM driver, nomodeset leaves Xorg without any display device",
    "families": [
      {"name": "simpledrm", "symbols": {"SYSFB_SIMPLEFB": "y", "DRM_SIMPLEDRM": "y|m"}},
      {"name": "efidrm and vesadrm", "symbols": {"DRM_EFIDRM": "y|m", "DRM_VESADRM": "y|m"}}
    ],
    "module_names": {"DRM_SIMPLEDRM": "simpledrm", "DRM_EFIDRM": "efidrm", "DRM_VESADRM": "vesadrm"},
    "required": [
      {"id": "yama", "name": "Yama (ptrace_scope)", "symbols": {"SECURITY": "y", "SECURITY_YAMA": "y"}, "lists": {"LSM": ["yama"]},
       "why": "the AI rescue stick sets kernel.yama.ptrace_scope=1 so that the agents (user rescue-ai) cannot read or inject into each other's processes; a kernel without Yama in CONFIG_LSM silently ignores the sysctl"}
    ]
  },
  "initramfs": {
    "required": [
      "usr/bin/dmsquash-live-root",
      "var/lib/dracut/hooks/cmdline/30-parse-dmsquash-live.sh",
      "var/lib/dracut/hooks/pre-udev/30-dmsquash-live-genrules.sh"
    ],
    "required_modules": ["isofs", "squashfs", "overlay", "loop", "usb-storage", "uas", "vmd", "sdhci-pci", "mmc-block", "dm-crypt", "raid1"],
    "min_keymaps": 20
  },
  "squashfs": {
    "required": [
      {"path": "etc/init.d/gentoo-installerd", "type": "file", "executable": true},
