      {"path": "usr/share/themes/Arc-Dark/gtk-3.0/gtk.css", "type": "file"},
      {"path": "usr/share/themes/Arc-Dark/xfwm4/themerc", "type": "file"},
      {"path": "usr/share/icons/Papirus-Dark/index.theme", "type": "file"},
      {"path": "usr/bin/firefox-bin", "type": "file|slink"},
      {"path": "usr/share/applications/xfce4-terminal.desktop", "type": "file"},
      {"path": "usr/share/applications/thunar.desktop", "type": "file"},
      {"path": "usr/share/applications/gparted.desktop", "type": "file"},
      {"path": "etc/lvm/lvmlocal.conf", "type": "file"},
      {"path": "etc/mdadm.conf", "type": "file"},
      {"path": "etc/chrony/chrony.conf", "type": "file"},
      {"path": "etc/conf.d/autoconfig", "type": "file"},
