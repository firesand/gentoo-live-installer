      {"path": "usr/bin/gentoo-rescue-do", "type": "file|slink", "executable": true, "when_source": {"path": "pyproject.toml", "contains": "gentoo-rescue-do ="}},
      {"path": "usr/bin/gentoo-rescue-approver", "type": "file|slink", "executable": true, "when_source": {"path": "pyproject.toml", "contains": "gentoo-rescue-approver ="}},
      {"path": "usr/bin/gentoo-rescue-mount", "type": "file|slink", "executable": true, "when_source": {"path": "pyproject.toml", "contains": "gentoo-rescue-mount ="}},
      {"path": "usr/bin/gentoo-rescue-share", "type": "file|slink", "executable": true, "when_source": {"path": "pyproject.toml", "contains": "gentoo-rescue-share ="}},
      {"path": "boot/memtest86plus/memtest64.bios", "type": "file"},
      {"path": "boot/memtest86plus/memtest.efi64", "type": "file"},
      {"path": "mnt/gentoo", "type": "dir"},
      {"path": "mnt/rescue", "type": "dir", "mode": "0700"},
      {"path": "home/gentoo", "type": "dir"},
      {"path": "usr/lib/modules", "type": "dir"},
      {"path": "usr/lib/grub/i386-pc", "type": "dir"},
      {"path": "usr/lib/grub/x86_64-efi", "type": "dir"},
      {"path": "usr/lib/firmware", "type": "dir"}
    ],
    "commands": [
      "lsblk", "findmnt", "blkid", "sgdisk", "parted", "partprobe", "udevadm", "wipefs", "mkswap", "swapon",
      "mkfs.ext4", "e2fsck", "mkfs.vfat", "fsck.vfat", "mkfs.xfs", "xfs_repair", "mkfs.btrfs", "btrfs",
      "fsck.f2fs", "fsck.exfat", "ntfsfix", "cryptsetup", "lvm", "mdadm", "thin_check", "dmsetup",
      "efibootmgr", "grub-install", "os-prober", "mokutil", "sbverify", "sbsign",
      "smartctl", "nvme", "hdparm", "lshw", "lspci", "lsusb", "dmidecode", "ddrescue", "testdisk", "fuser",
      "cpuid2cpuflags", "setxkbmap", "xrandr", "xset", "chronyd", "jq", "pv", "links", "gpg", "gpgv",
      "tar", "rsync", "gparted", "lsof", "lvs", "lscpu", "chronyc", "loadkeys", "nmtui", "nmcli",
      "blockdev", "mount", "umount", "dmesg", "script", "setsid", "chroot", "timeout", "sync", "modprobe",
      "dumpe2fs", "tune2fs", "xfs_db", "jfs_fsck", "lsinitrd", "pvs", "vgs", "vgchange", "zstd",
      "tmux", "ttyd", "qrencode", "rg", "openssl", "chvt", "setpriv",
      "snapper", "fsarchiver", "ncdu", "tcpdump", "mtr", "dd_rescue", "dislocker", "foremost", "memtester", "restic", "rclone", "mount.cifs", "vim", "mc"
    ],
    "implicit_services": [["autoconfig", "default"], ["xdm", "default"], ["fixinittab", "default"], ["syslog-ng", "default"], ["sysctl", "boot"]],
    "forbidden_services": ["acpid"],
    "forbidden": [
      "var/cache/binhost*",
      {"pattern": "opt/rust-bin*", "types": ["file", "slink"]},
      "usr/lib64/libQt6*.a",
      "usr/share/doc",
      "usr/share/doc/*",
      "usr/share/gtk-doc*",
      "etc/portage/make.conf.extra",
      "etc/portage/make.conf.old",
      "var/db/repos/*",
      "usr/src/*",
      "etc/ssh/ssh_host_*"
    ],
    "accounts": [
      {"name": "rescue-ai", "max_uid": 999, "no_sudo": true,
       "forbidden_groups": ["tty", "wheel", "disk", "video", "input", "audio", "plugdev", "usb", "kvm", "portage", "root", "users", "gentoo-installer", "dialout", "cdrom", "floppy", "games", "lp", "uucp"],
       "why": "the AI agents run as rescue-ai on a stick next to somebody's broken disk; their only way to root is gentoo-rescue-do, approved by a person on the approver's own console. wheel is the group Catalyst gives passwordless sudo and su needs; the live user's empty password must not be reachable through it"}
    ],
    "sshd_first_values": {
      "release": {"PermitEmptyPasswords": "no"},
      "testkey": {"PermitEmptyPasswords": "no", "PermitRootLogin": "prohibit-password"}
    },
    "owner_exceptions": ["home/gentoo", "home/gentoo/*", "var/spool/mail/gentoo"],
    "required_packages": [
      "app-admin/gentoo-live-installer", "app-misc/hwmonux", "app-portage/portagehub",
      "app-arch/zstd", "app-crypt/sbsigntools", "app-misc/jq", "app-portage/cpuid2cpuflags",
      "gnome-extra/polkit-gnome", "net-misc/chrony", "sys-apps/hdparm", "sys-apps/kmod", "sys-apps/lshw",
      "sys-apps/memtest86+", "sys-apps/nvme-cli", "sys-apps/pv", "sys-apps/smartmontools",
      "sys-block/gparted", "sys-block/thin-provisioning-tools", "sys-boot/efibootmgr", "sys-boot/grub",
      "sys-boot/mokutil", "sys-boot/os-prober", "sys-fs/btrfs-progs", "sys-fs/cryptsetup", "sys-fs/dosfstools",
      "sys-fs/e2fsprogs", "sys-fs/exfatprogs", "sys-fs/f2fs-tools", "sys-fs/jfsutils", "sys-fs/lvm2",
      "sys-fs/mdadm", "sys-fs/ntfs3g", "sys-fs/xfsprogs", "sys-kernel/dracut", "sys-process/psmisc",
      "www-client/links", "x11-apps/setxkbmap", "x11-apps/xrandr", "xfce-extra/xfce4-xkb-plugin",
      "x11-themes/arc-theme", "x11-themes/papirus-icon-theme", "media-fonts/fira-sans", "media-fonts/jetbrains-mono",
      "xfce-extra/xfce4-notifyd", "xfce-extra/xfce4-pulseaudio-plugin", "xfce-extra/xfce4-whiskermenu-plugin", "www-client/firefox-bin",
      "app-backup/fsarchiver", "app-backup/restic", "app-backup/snapper", "app-editors/vim", "app-forensics/foremost", "app-misc/mc",
      "media-gfx/qrencode", "net-analyzer/mtr", "net-analyzer/tcpdump", "net-fs/cifs-utils", "net-misc/rclone", "sys-apps/memtester",
      "sys-apps/ripgrep", "sys-fs/dd-rescue", "sys-fs/dislocker", "sys-fs/ncdu", "www-apps/ttyd"
    ],
    "forbidden_packages": ["dev-lang/rust-bin", "dev-lang/go", "sys-boot/shim", "net-misc/netifrc"],
    "content": [
      {"path": "etc/lvm/lvmlocal.conf", "must_match": ["^\\s*event_activation\\s*=\\s*0\\b", "^\\s*auto_activation_volume_list\\s*=\\s*\\[\\s*\\]"],
       "why": "the live system must not activate the PC's volume groups by itself"},
      {"path": "etc/mdadm.conf", "must_match": ["^AUTO -all$"],
       "why": "the live system must not assemble the PC's RAID arrays by itself"},
      {"path": "etc/conf.d/autoconfig", "must_match": ["^ACPI=\"no\"$"],
       "why": "acpid would power the PC off on a button press during an installation"},
      {"path": "etc/elogind/logind.conf.d/50-gentoo-live.conf",
       "must_match": ["^HandleLidSwitch=ignore$", "^HandleLidSwitchExternalPower=ignore$", "^HandleLidSwitchDocked=ignore$", "^IdleAction=ignore$"],
       "why": "closing the lid must not suspend an installation"},
      {"path": "etc/xdg/autostart/xfce4-screensaver.desktop", "must_match": ["^Hidden=true$"],
       "why": "a locked or blanked screen must not hide an installation"},
      {"path": "etc/xdg/autostart/polkit-gnome-authentication-agent-1.desktop",
       "must_match": ["^OnlyShowIn=XFCE;$", "^Exec=/usr/libexec/polkit-gnome-authentication-agent-1$"], "must_not_match": ["^AutostartCondition="],
       "why": "GParted and other programs that ask for administrator rights need a password dialog in the live session"},
      {"path": "etc/xdg/xfce4/xfconf/xfce-perchannel-xml/thunar-volman.xml", "must_match": ["automount-drives"],
       "why": "the desktop must not mount the PC's disks by itself"},
      {"path": "etc/chrony/chrony.conf", "must_match": ["^makestep\\b"], "must_not_match": ["^\\s*rtcsync", "^\\s*rtcfile"],
       "why": "the live system corrects its clock but never writes the PC's hardware clock"},
      {"path": "etc/xfce4/helpers.rc", "must_match": ["^WebBrowser=gentoo-live-browser$"], "why": "the Handbook launcher and every link open the real browser of the image (an empty value opens a dialog)"},
      {"path": "usr/share/xfce4/helpers/gentoo-live-browser.desktop", "must_match": ["^Type=X-XFCE-Helper$", "^X-XFCE-Category=WebBrowser$", "^X-XFCE-Binaries=firefox-bin;$"], "why": "libxfce4ui's own Firefox helper does not name the firefox-bin program"},
      {"path": "etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml", "must_match": ["\"ThemeName\" type=\"string\" value=\"Arc-Dark\"", "\"IconThemeName\" type=\"string\" value=\"Papirus-Dark\"", "value=\"Fira Sans 10\"", "value=\"JetBrains Mono 11\""], "why": "the live desktop's look (wave 5)"},
      {"path": "etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xfwm4.xml", "must_match": ["\"theme\" type=\"string\" value=\"Arc-Dark\"", "\"use_compositing\" type=\"bool\" value=\"true\""], "why": "window frames and shadows of the live desktop"},
      {"path": "etc/xdg/xfce4/panel/default.xml", "must_match": ["\"size\" type=\"uint\" value=\"44\"", "\"position-locked\" type=\"bool\" value=\"true\"", "gentoo-installer\\.desktop", "gentoo-rescue\\.desktop", "gentoo-handbook\\.desktop"], "why": "one 44 px bottom panel with the Install, Repair and Handbook launchers"},
      {"path": "etc/lightdm/lightdm-gtk-greeter.conf", "must_match": ["^theme-name = Arc-Dark$", "^icon-theme-name = Papirus-Dark$", "indigo-silk\\.svg"], "why": "the login screen matches the desktop"},
      {"path": "etc/portage/make.conf",
       "must_match": ["^VIDEO_CARDS="],
       "must_not_match": ["^MAKEOPTS=", "^NINJAOPTS=", "^EMERGE_DEFAULT_OPTS=", "^DISTDIR=", "^PKGDIR=", "^FEATURES=.*\\bbuildpkg\\b", "^ACCEPT_LICENSE=\"\\*\""],
       "why": "the builder's job counts, caches and licence wildcard must not leak onto somebody's PC"},
      {"path": "etc/ssh/sshd_config.d/10-gentoo-live.conf", "must_match": ["^PermitEmptyPasswords no$"], "must_not_match": ["^\\s*PermitRootLogin", "^\\s*PasswordAuthentication"],
       "why": "sshd runs at boot on the live disc; the live user has an empty password, which must never work over SSH, and root login stays as on the official media"},
      {"path": "etc/motd", "must_match": ["gentoo-rescue", "gentoo-installer", "gentoo-remote-access", "passwd root"], "why": "first-time users need to know where repair is and how to log in from another computer"},
      {"path": "etc/issue", "must_match": ["gentoo-rescue", "gentoo-remote-access"], "why": "first-time users need to know where repair is and how to log in from another computer"},
      {"path": "etc/motd", "must_match": ["gentoo-installer-text"], "when_source": {"path": "pyproject.toml", "contains": "gentoo-installer-text ="},
       "why": "the text installer is advertised on a text console only when the package has it"},
      {"path": "etc/profile.d/20-gentoo-autostart.sh", "must_match": ["gentoo\\.autostart=rescue ", "gentoo\\.autostart=ai-rescue ", "gentoo\\.autostart=installer-text ", "sudo", "gentoo-rescue-ai"],
       "why": "the boot menu entries Repair a system and Install in text mode start their tool through this hook"},
      {"path": "etc/sysctl.d/60-gentoo-rescue-ai.conf", "must_match": ["^kernel\\.yama\\.ptrace_scope\\s*=\\s*1$"], "must_not_match": ["ptrace_scope\\s*=\\s*0"],
       "why": "Yama keeps the AI agents from reading or injecting into each other's processes (the sysctl service runs in the boot runlevel)"},
      {"path": "etc/polkit-1/rules.d/00-gentoo-rescue-ai.rules", "must_match": ["rescue-ai", "polkit\\.Result\\.NO"],
       "why": "the live user has an empty password and polkit offers wheel as its administrators: without this rule an agent could pkexec its way to root"},
      {"path": "etc/pam.d/su", "must_match": ["^auth\\s+required\\s+pam_wheel\\.so\\s+use_uid\\s*$"], "must_not_match": ["^\\s*auth\\s.*pam_wheel\\.so.*\\b(root_only|trust)\\b"],
       "why": "rescue-ai is not in wheel, so su to the live user (empty password, passwordless sudo) must be refused by pam_wheel: without it an agent reaches root with no approver"},
      {"path": "etc/init.d/gentoo-rescue-approver", "must_match": ["gentoo\\.autostart=ai-rescue", "do-password", "umask 077", "gentoo-rescue-approver", "rescue-ai"],
       "must_not_match": ["command_user", "\\bsudo\\b"],
       "why": "the approver is root's own service, started only by the AI rescue boot entry, with a per-boot password nobody but root can read"},
