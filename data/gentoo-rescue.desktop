[Desktop Entry]
Type=Application
Name=Repair a Gentoo System
GenericName=Gentoo Repair
Comment=Repair a Gentoo system that does not start
Exec=gentoo-installer --mode repair
Icon=system-run
Terminal=false
Categories=System;Filesystem;
Keywords=gentoo;repair;rescue;boot;grub;fstab;chroot;initramfs;fix;
StartupNotify=true
