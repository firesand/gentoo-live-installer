# Kernel configuration fragment of the live disc's AI rescue stick (wave 6).
#
# Installed as /etc/kernel/config.d/51-gentoo-live-rescue-ai.config by
# app-admin/gentoo-live-installer[rescue-ai] and merged by the kernel-build eclass into the
# configuration of sys-kernel/gentoo-kernel when Catalyst builds the live kernel (stage2), like the
# fragment of the "Safe graphics" entry.
#
# Why: /etc/sysctl.d/60-gentoo-rescue-ai.conf sets kernel.yama.ptrace_scope=1, which keeps the AI agents
# (the user rescue-ai) from reading or injecting into each other's processes. The sysctl only exists in
# a kernel with Yama built in AND named in CONFIG_LSM (an LSM that is built but not listed is not
# enabled). The list keeps the usual order of the kernel's own default (landlock, lockdown, yama,
# integrity, bpf); an entry the kernel does not have is ignored. scripts/verify-iso.py reads
# boot/gentoo-config and fails the build when Yama is not there, so a base configuration that
# overrides this fragment cannot go unnoticed.
CONFIG_SECURITY=y
CONFIG_SECURITY_YAMA=y
CONFIG_LSM="landlock,lockdown,yama,integrity,bpf"
