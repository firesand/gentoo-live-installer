#!/bin/sh
# A shell inside the Gentoo system on this computer, the Handbook's "chroot", in one command:
#     sudo gentoo-chroot
# It finds the system, asks for the password of an encrypted disk, mounts it, opens a shell with a "(chroot) " prompt and
# unmounts everything when you type exit. With a SESSION (a system the repair tool has mounted, see "gentoo-rescue status")
# it opens a shell in that session instead:
#     gentoo-chroot SESSION [--writable]
# Other options: --read-only (do not ask), --writable (read-write without asking), --help.
exec gentoo-rescue chroot "$@"
