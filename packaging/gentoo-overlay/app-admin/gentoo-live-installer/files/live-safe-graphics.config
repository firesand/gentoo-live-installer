# Kernel configuration fragment of the live disc (H1, "Safe graphics").
#
# Installed as /etc/kernel/config.d/50-gentoo-live-safe-graphics.config by
# app-admin/gentoo-live-installer[safe-graphics] and merged by the kernel-build eclass into the
# configuration of sys-kernel/gentoo-kernel when Catalyst builds the live kernel (stage2).
#
# Why: the distribution kernel has no generic framebuffer DRM driver, so under "nomodeset"
# (the native drivers nouveau, amdgpu, i915, ... refuse to load) there is no DRM device, no
# /dev/fb0 and Xorg cannot start. With these symbols the picture the firmware set up (EFI GOP or
# VESA) becomes a DRM device that Xorg's modesetting driver can use: slow, no 3D, but a desktop on
# every PC.
#
# DRM is built in because DRM_SIMPLEDRM can only be built in when the DRM core is; the GPU drivers
# stay modules. The drivers are built in (not modules) so that they exist before the initramfs
# runs and work with the stock dracut module set.
CONFIG_DRM=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# Kernels from 6.16 have DRM_EFIDRM and DRM_VESADRM, an alternative to SYSFB_SIMPLEFB + DRM_SIMPLEDRM
# (their Kconfig depends on !SYSFB_SIMPLEFB, so olddefconfig may drop them again: harmless; either
# family satisfies scripts/verify-iso.py). Older kernels do not know the symbols and ignore the lines.
CONFIG_DRM_EFIDRM=y
CONFIG_DRM_VESADRM=y
